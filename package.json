{
  "name": "temp_vite",
  "private": true,
  "version": "0.0.0",
  "description": "A Mod Loader for Dragon Ball: Sparking! ZERO",
  "author": "Kamisama",
  "repository": {
    "type": "git",
    "url": "https://github.com/owner/repo.git"
  },
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json && node -e \"require('node:fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:e2e": "pnpm build && playwright test --config=playwright.e2e.config.ts",
    "test:e2e:install": "pnpm test:e2e",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "build": {
    "appId": "com.kamisama.modloader",
    "productName": "Kamisama Mod Loader",
    "directories": {
      "output": "release"
    },
    "protocols": {
      "name": "kamisama-protocol",
      "schemes": [
        "kamisama",
        "gb-modmanager"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.562.0",
    "p-limit": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.6",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "packageManager": "pnpm@8.14.3+sha1.872b21adeaae4e71acd5c551ba848d927d6aa446"
}
